# Optional: enables the Claude multimodal reviewer (AI audience reactions + extra suggestions).
ANTHROPIC_API_KEY=
# Model for the reviewer (default claude-opus-5-5)
YTS_LLM_MODEL=claude-opus-5-5
# Set to 0 to force rule-based agents even when a key is present
YTS_USE_LLM=1
# Where uploads, analyses and the trained model live (default ./data)
YTS_DATA_DIR=
# Python interpreter used for the worker
PYTHON=python3
# Whisper model size when faster-whisper is installed (tiny, base, small, ...)
WHISPER_MODEL=base
